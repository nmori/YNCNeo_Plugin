<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ゆかりねっとコネクターNEO v3.0 以降 (.NET 10) 向けプラグイン雛形

    v3.0 で本体が .NET Framework 4.8 から .NET 10 に移行したため、プラグインも
    SDK 形式の csproj で net10.0-windows を対象にしてビルドします。
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>YNC_NeoPlugin</RootNamespace>
    <!-- 生成される DLL 名。Plugin_Tag と同じ名前にするとロードが速くなります -->
    <AssemblyName>Plugin_Prototype</AssemblyName>
    <Platforms>AnyCPU;x64</Platforms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>

    <!-- ★必須★ プラグインはホストが Assembly.LoadFrom で動的に読み込む DLL です。
         .NET 10 ではライブラリの NuGet 依存は既定で出力にコピーされないため、
         これを付けないと Newtonsoft.Json.dll などが出力に並ばず
         「ビルドは通るのに読み込み時に落ちる」状態になります。 -->
    <EnableDynamicLoading>true</EnableDynamicLoading>

    <!-- 設定画面が WinForms のため -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- ホストの Dispatcher (System.Windows.Threading) を使うため。WPF の画面を作る場合もこれで足ります -->
    <UseWPF>true</UseWPF>

    <!-- 出力先を bin\<Config>\ のままにする (net10.0-windows\ や win-x64\ の階層を足さない) -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <!-- Properties\AssemblyInfo.cs を手書きで持っているため -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- 本体と同じ版。本体が先に読み込んだ版が使われるため、これより新しい API は使わないこと -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- 配布フォルダに置くファイル -->
    <None Update="plugin_prop.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Newtonsoft_Json_License_MIT.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- 同梱の SDK・サンプルは別プロジェクトなので、この雛形のビルドには含めない -->
    <Compile Remove="SDK\**;Samples\**" />
    <EmbeddedResource Remove="SDK\**;Samples\**" />
    <None Remove="SDK\**;Samples\**" />
  </ItemGroup>

</Project>
